# Copy to server/.env and fill in your own values.
# server/.env is gitignored. Never commit real credentials.

# MySQL host and port.
DB_HOST=localhost
DB_PORT=3306

# MySQL user and password. An empty password is allowed.
DB_USER=root
DB_PASSWORD=YOUR_PASSWORD_HERE

# Database the app uses. Created by the first migration if it does not exist.
DB_NAME=my_garden_db
